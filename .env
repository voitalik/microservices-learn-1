# DB variables in a container
RESOURCE_POSTGRES_DB=resource-db
RESOURCE_POSTGRES_USER=postgres
RESOURCE_POSTGRES_PASSWORD=postgres
RESOURCE_DB_URL="jdbc:postgresql://resource-db:5432/${RESOURCE_POSTGRES_DB}"

# host ports mapped from a container
RESOURCE_DB_PORT=5432
RESOURCE_SERVICE_PORT=8071

# DB variables in a container
SONG_POSTGRES_DB=song-db
SONG_POSTGRES_USER=postgres
SONG_POSTGRES_PASSWORD=postgres
SONG_DB_URL="jdbc:postgresql://song-db:5432/${SONG_POSTGRES_DB}"

# host ports mapped from a container
SONG_DB_PORT=5433
SONG_SERVICE_PORT=8072

# address of the song serive inside a container
SONG_SERVICE_URL=http://song-service:8072
